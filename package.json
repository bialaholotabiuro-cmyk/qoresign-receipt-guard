{
  "name": "qoresign-receipt-guard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "QoreSign Receipt Guard: tamper-evident receipts, hybrid-signed (secp256k1 + ML-DSA-87) with QoreX and anchored on QoreChain testnet.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "cli": "tsx scripts/cli.ts",
    "test": "vitest run",
    "test:live": "QRG_LIVE=1 vitest run tests/live.test.ts",
    "e2e": "node e2e/mock-qorex.e2e.mjs"
  },
  "dependencies": {
    "@cosmjs/stargate": "^0.39.0",
    "@noble/hashes": "^1.8.0",
    "@qorechain/qoresign": "^0.2.0",
    "@qorechain/sdk": "^0.14.0",
    "@scure/bip39": "^1.6.0",
    "cosmjs-types": "^0.11.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.10",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "puppeteer-core": "^23.11.1",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.0",
    "vitest": "^3.2.7"
  },
  "license": "MIT"
}
